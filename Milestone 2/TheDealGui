import javax.swing.*;
import java.awt.*;
import java.io.*;
import java.util.Random;
import java.net.*;


public class TheDealGui extends Jframe{
    private Socket socket;
    private BufferedReader in;
    private PrintWriter out;

    private DefaultListModel<String> leaderboardModel;
    private JLabel timerLabel;
    private Timer timer;
    private JLabel statusLabel;
    private int countdown = 60;
    private String playerId;
    private JTextField bidField;

    public TheDealGui(String host, int port) {
        this.playerId = String.format("Player-%06d", new Random().nextInt(999999));
        setupUI();
        connectToServer(host, port);

    }

    private void setupUI() {
        setTitle ("THE DEAL - " + playerId);
        setSize(400, 550);
        setCloseOpDefault(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout(10, 10));


        JPanel topPanel = new JPanel(new GridLayout(2, 1));
        timerLabel = new JLabel("Time Left: 60s", SwingConstants.CENTER);
        timerLabel.setFont(new Font("Arial", Font.BOLD, 18));
        statusLabel = new JLabel("Waiting for bidders...", SwingConstants.CENTER);
        topPanel.add(timerLabel);
        topPanel.add(statusLabel);
        add(topPanel, BorderLayout.NORTH);
        
        leaderboardModel = new DefaultListModel<>();
        JList<String> leaderboardList = new JList<>(leaderboardModel);
        add(new JSrollP(leaderboardList), BorderLayout.Center);

        JPanel footer = new JPanel(new BorderLayout());
        bidField = new JTextField();
        JButton bidButton = new JButton("Place Bid");

        footer.add(new JLabel ("Your Bid: "), BorderLayout.WEST);
        footer.add(bidField, BorderLayout.CENTER);
        footer.add(bidButton, BorderLayout.EAST);
        add(footer, BorderLayout.SOUTH);

        bidButton.addActionListener(e -> sendBid());
        bidField.addActionListener(e -> sendBid());

        intializeTimer();


    }  

    private void connectToServer(String host, int port) {
        try{
            socket = new Sockey(host, port);
            out = new PrintWriter(socket.getOutputStream(), true);
            in = new BufferReader(new InputupStreamReader(socket.getInputStream()));

            out.println(buyerId);
        } catch (IOException e) {
            e.printStackTrace(); */reports error in detail to standard error stream, prevents entire program crash */
            JOptionPane.showMessageDialog(this, "Unable to connect to server: " + e.getMessage());
        }
    }

    new Thread (() -> {
        try {
            String message;
            while((message = in.readLine()) !=null) {
                String finalMessage = message; 
                SwingUtilities.invokeLater(() -> processServerMessage(finalMessage));

            }
        } catch (IOException e) {
            JOptionPane.showMessageDialog(this, "Connection lost: " + e.getMessage());
            System.exit(1);
        }
        }).start();
    }catch (IOException e) {
        JOptionPane.showMessageDialog(this, "Connection lost: " + e.getMessage());
